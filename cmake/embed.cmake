# Turns the shell integration scripts into a C++ source file, so st ships as a
# single binary. Run by CMake at build time:
#   cmake -DSRC_DIR=<repo> -DFILES="shell/a.ps1,shell/b.bash" -DOUT=<file.cpp> -P embed.cmake
string(REPLACE "," ";" file_list "${FILES}")
set(body "")
set(table "")
set(i 0)
foreach(f IN LISTS file_list)
    file(READ "${SRC_DIR}/${f}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR len "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name "${f}" NAME)
    string(APPEND body "static const unsigned char k${i}[] = {${bytes}0x00};\n")
    string(APPEND table "    {\"${name}\", k${i}, ${len}},\n")
    math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed.cmake from shell/. Do not edit.
#include <cstddef>
#include <cstring>
#include <string_view>

namespace st {
${body}
struct EmbeddedEntry { const char* name; const unsigned char* data; std::size_t size; };
static const EmbeddedEntry kEmbedded[] = {
${table}};

std::string_view embedded_file(const char* name) {
    for (const auto& e : kEmbedded)
        if (std::strcmp(e.name, name) == 0) return {reinterpret_cast<const char*>(e.data), e.size};
    return {};
}
}  // namespace st
")
# Only touch the output when it changed, so builds stay incremental.
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
