// Icon and version details for st.exe (Explorer, the Start menu, Task Manager, Installed apps).
#include <winver.h>

1 ICON "@ST_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Glen Rhodes"
            VALUE "FileDescription", "SuperTerminal"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "st"
            VALUE "LegalCopyright", "Copyright (c) 2026 Glen Rhodes. MIT License."
            VALUE "OriginalFilename", "st.exe"
            VALUE "ProductName", "SuperTerminal"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
